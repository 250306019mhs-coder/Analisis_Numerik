#METODE GAUSS
import numpy as np #untuk mengolah data
A = np.array([[3.0, 1.0, -4.0], [-2.0, 3.0, 1.0], [2.0, 0.0, 5.0]]) #matriks A
print ("matriks A")
print(A)
b = np.array([7.0, -5.0, 10.0]) #vektor konstanta 3 elemen
print("matriks b kolom")
print(b)
b = b.reshape(-1, 1)
print("matriks b")
print(b)


def eliminasi_gauss(A, b):
  n = len(b) #hitung berapa angka yang di variabel b
  Ab = np. hstack ([A, b.reshape(-1, 1)])
  #Ab -> variabel untuk menyimpan matriks A, dan vektor b
  #np.hstack -> untuk menggabungkan 2 matriks. Jika tanpa np.hstack akan akan eroor di baris pivot
  #b.reshape -> agar vektor 3 yang di b diubah yang awalnya datar menjadi tegak

  print("=== Matriks Augmented Awal ===")
  print(Ab)
  print("=" * 45) #print = sebyk 45

#perulangan
  for i in range(n):

    pivot = Ab[i, i]
    if abs(pivot) < 1e-12:
      print(f"Error: Pivot bernilai nol pada baris {i + 1}.")
      return None


    for j in range(i + 1, n):
      faktor = Ab[j, i] / Ab[i, i]
      Ab[j, i:] = Ab[j, i:] - faktor * Ab[i, i:]

    print(f"Setelah Eliminasi Kolom {i + 1}:")
    print(Ab)
    print("-" * 45)

  x = np.zeros(n)
  for i in range(n - 1, -1, -1):
    x[i] = (Ab[i, -1] - np.dot(Ab[i, i + 1 : n], x[i + 1 : n])) / Ab[i, i]

  return x

hasil_solusi = eliminasi_gauss(A, b)

if hasil_solusi is not None:
  print("\n=== Hasil Solusi Akhir ===")
  print(f"x1 = {hasil_solusi[0]:.4f}  (Pecahan: 260/81)")
  print(f"x2 = {hasil_solusi[1]:.4f}  (Pecahan: 19/81)")
  print(f"x3 = {hasil_solusi[2]:.4f}  (Pecahan: 58/81)")



#METODE LU
import numpy as np

A = np.array([[3.0, 1.0, -4.0], [-2.0, 3.0, 1.0], [2.0, 0.0, 5.0]])

b = np.array([7.0, -5.0, 10.0])

def lu_decomposition(A, b):
  n = len(b)

  L = np.zeros((n, n))
  U = np.zeros((n, n))


  for i in range(n):

    L[i, i] = 1.0


    for j in range(i, n):
      soma = sum(L[i, k] * U[k, j] for k in range(i))
      U[i, j] = A[i, j] - soma


    for j in range(i + 1, n):
      soma = sum(L[j, k] * U[k, i] for k in range(i))
      if U[i, i] == 0:
        raise ValueError("Pivot nol ditemukan, dekomposisi LU gagal.")
      L[j, i] = (A[j, i] - soma) / U[i, i]

  print("=== Matriks L (Lower) ===")
  print(np.round(L, 4))
  print("\n=== Matriks U (Upper) ===")
  print(np.round(U, 4))
  print("-" * 45)


  y = np.zeros(n)
  for i in range(n):
    soma = sum(L[i, k] * y[k] for k in range(i))
    y[i] = b[i] - soma


  x = np.zeros(n)
  for i in range(n - 1, -1, -1):
    soma = sum(U[i, k] * x[k] for k in range(i + 1, n))
    x[i] = (y[i] - soma) / U[i, i]

  return y, x

y_vektor, hasil_solusi = lu_decomposition(A, b)

print("\n=== Hasil Solusi Akhir ===")
print(f"x1 = {hasil_solusi[0]:.4f}  (Pecahan: 260/81)")
print(f"x2 = {hasil_solusi[1]:.4f}  (Pecahan: 19/81)")
print(f"x3 = {hasil_solusi[2]:.4f}  (Pecahan: 58/81)")
