import numpy as np
from scipy.interpolate import lagrange

print("=" * 60)
print("IMPLEMENTASI POLINOMIAL LAGRANGE")
print("=" * 60)

#input data
x = np.array([20.0, 50.0, 80.0], dtype=float)
y = np.array([45.0, 80.0, 95.0], dtype=float)

#Perhitungan interpolasi
poly_lagrange = lagrange(x, y)

#Menghitung nilai y yang dicari
x_target = 60.0
y_pred = poly_lagrange(x_target)

print(f"Nilai data x (%): {x}")
print(f"Nilai data y (Mbps): {y}")
print(f"Estimasi nilai throughput pada saat x = {x_target} % adalah y = {y_pred:.5f} Mbps")
